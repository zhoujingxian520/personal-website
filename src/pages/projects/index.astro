---
import Base from '../../layouts/Base.astro';
import SummaryCard from '../../components/SummaryCard.astro';
import {getCollection} from 'astro:content';
const entries=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Base title="项目"><h1>项目</h1><p class="page-intro">把想法变成作品，记录每一次尝试。</p>{entries.map(entry=><SummaryCard entry={entry} kind="project"/>)}<p id="learning-empty" class="empty-message" hidden={entries.length>0}>暂无对应记录。</p></Base>
